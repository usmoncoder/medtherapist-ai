# ── Majburiy ──────────────────────────────────────────────────────────────
MONGODB_URI=mongodb+srv://user:parol@cluster0.example.mongodb.net/medtherapist?appName=Cluster0
JWT_SECRET=uzun-va-tasodifiy-maxfiy-kalit-kamida-32-belgi
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── AI Assistant (https://aistudio.google.com/apikey) ─────────────────────
# Kalit bo'lmasa AI bo'limi "sozlanmagan" deb ko'rsatadi, qolgan tizim ishlaydi
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
GEMINI_FALLBACK_MODELS=gemini-flash-latest,gemini-3.6-flash
GEMINI_TIMEOUT_MS=45000

# ── Pochta (parolni tiklash). Bo'sh bo'lsa havola server logiga yoziladi ──
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=MedTherapist AI <no-reply@medtherapist.uz>

# ── Ixtiyoriy ─────────────────────────────────────────────────────────────
REDIS_URL=
UPLOAD_DIR=./uploads
MAX_UPLOAD_BYTES=10485760
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info
MONGO_POOL_SIZE=10
# HTTPS ortida turmasa (lokal `npm start`) false qiling. Serverda o'zgartirmang!
COOKIE_SECURE=

# Tibbiy matnni shifrlash uchun 32 baytli kalit (openssl rand -hex 32)
# O'ZGARTIRMANG — o'zgartirsangiz eski yozuvlar o'qilmaydi!
ENCRYPTION_KEY=
