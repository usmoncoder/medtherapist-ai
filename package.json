{
  "name": "medtherapist-ai",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "node --env-file=.env server.js",
    "build": "next build",
    "start": "NODE_ENV=production node --env-file=.env server.js",
    "seed": "node --env-file=.env scripts/seed.js",
    "test:smoke": "node --env-file=.env scripts/smoke-test.mjs",
    "test:smoke:ai": "node --env-file=.env scripts/smoke-test.mjs http://localhost:3000 --ai",
    "backup": "node --env-file=.env scripts/backup.mjs",
    "restore": "node --env-file=.env scripts/restore.mjs",
    "keygen": "node -e \"console.log(require('node:crypto').randomBytes(32).toString('hex'))\"",
    "check:i18n": "node scripts/check-i18n.mjs",
    "test": "npm run check:i18n && npm run build"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cookie": "^0.7.2",
    "ioredis": "^6.0.0",
    "jose": "^5.9.6",
    "mongoose": "^8.9.0",
    "next": "^15.1.0",
    "nodemailer": "^10.0.1",
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1",
    "zod": "^3.24.1"
  },
  "overrides": {
    "postcss": "^8.5.28"
  },
  "engines": {
    "node": ">=20.9.0"
  }
}
